# KoalaTower — Caddy reverse proxy config
#
# Copy to your Caddyfile or include it.
# Assumes KoalaTower runs in a Docker container named "koala-tower"
# on port 8080 (see docker-compose.yml).

koalatower.example.com {
    # Serve pre-compressed .br / .gz assets generated by `precompress: true`
    # in svelte.config.js. Caddy negotiates the best encoding per client.
    # Requires Caddy 2.6+ for the `precompressed` option.
    file_server {
        precompressed br gzip zstd
    }

    # Cache static assets
    header /_app/* Cache-Control "public, max-age=31536000, immutable"
    header /* Cache-Control "public, max-age=3600"

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Reverse proxy to the container
    reverse_proxy koala-tower:8080
}
