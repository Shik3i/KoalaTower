# ── Flatland TD environment ────────────────────────────────────────
# Copy to .env and fill in real values before deploying.
#
# All secrets below must be long random strings — never commit real values.
# The Docker image / docker-compose.example.yml use these same variables.

# -------------------------------------------------------------------
# Required in production
# -------------------------------------------------------------------

# Node environment (production enables secure session cookies)
NODE_ENV=production

# Port the Node server listens on
PORT=3000

# SQLite database path — must be on a persistent volume in production
DATABASE_PATH=/data/flatland.db

# Long random string for hashing session tokens — never reuse or share
SESSION_SECRET=replace-with-long-random-secret

# Long random string for password hashing — never reuse or share
AUTH_PASSWORD_PEPPER=replace-with-long-random-pepper

# Must match the Ko-fi verification_token configured in your Ko-fi
# webhook settings.  In production a missing value disables the webhook
# entirely (no events, no buff, safe 503).  Leave empty to disable.
KOFI_WEBHOOK_SECRET=replace-with-your-kofi-verification-token

# -------------------------------------------------------------------
# Optional
# -------------------------------------------------------------------

# Set to "false" or "0" to hide online-feature UI (account, cloud save).
# The /api/* routes still accept requests but the frontend won't show them.
PUBLIC_ONLINE_FEATURES_ENABLED=true
